{
  "name": "@jellypod/music-gen",
  "version": "0.1.3",
  "description": "Generate instrumental scores, MIDI, and WAV with an AI SDK model or an interactive agent skill",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jellypod-Inc/music-gen.git"
  },
  "engines": { "node": ">=20" },
  "bin": { "music-gen-instrumental": "dist/cli.js" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./renderers/fluidsynth": {
      "types": "./dist/renderers/fluidsynth.d.ts",
      "import": "./dist/renderers/fluidsynth.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "examples/*.ts",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "prepare": "npm run build",
    "test": "npm run build && node --import tsx --test test/*.test.ts evals/*.test.ts",
    "test:live": "npm run build && node --import tsx scripts/live-smoke.ts",
    "eval:music": "npm run build && node --import tsx evals/run.ts",
    "visualize": "node --import tsx tools/visualize.ts",
    "check": "npm test",
    "lint:changed": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json"
  },
  "dependencies": {
    "ai": "^7.0.124",
    "midi-file": "^1.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
